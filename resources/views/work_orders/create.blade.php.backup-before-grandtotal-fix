function fillMasterItemData(index)
{
    const row =
        document.querySelector(
            `[data-index="${index}"]`
        );

    if (!row) {
        return;
    }

    const type =
        row.querySelector(
            `select[name="items[${index}][item_type]"]`
        )?.value;

    const mode =
        row.querySelector(
            `select[name="items[${index}][mode]"]`
        )?.value;

    if (mode !== 'EXISTING') {
        return;
    }

    /*
     * ====================================================
     * JASA MASTER
     * ====================================================
     */
    if (type === 'SERVICE') {

        const serviceId =
            parseInt(
                row.querySelector(
                    `select[name="items[${index}][service_id]"]`
                )?.value || 0
            );

        const service =
            services.find(
                item => Number(item.id) === serviceId
            );

        if (!service) {
            return;
        }

        const code =
            row.querySelector(
                `input[name="items[${index}][service_code]"]`
            );

        const name =
            row.querySelector(
                `input[name="items[${index}][service_name]"]`
            );

        const price =
            row.querySelector(
                `input[name="items[${index}][service_default_price]"]`
            );

        const description =
            row.querySelector(
                `textarea[name="items[${index}][service_description]"]`
            );

        const duration =
            row.querySelector(
                `input[name="items[${index}][service_estimated_duration]"]`
            );

        if (code) {
            code.value = service.code ?? '';
        }

        if (name) {
            name.value = service.name ?? '';
        }

        if (price) {
            price.value = service.default_price ?? 0;
        }

        if (description) {
            description.value = service.description ?? '';
        }

        if (duration) {
            duration.value = service.estimated_duration ?? 0;
        }

        calculateWorkOrderTotal();

        return;
    }

    /*
     * ====================================================
     * SPAREPART MASTER
     * ====================================================
     */

    const productId =
        parseInt(
            row.querySelector(
                `select[name="items[${index}][product_id]"]`
            )?.value || 0
        );

    const product =
        products.find(
            item => Number(item.id) === productId
        );

    if (!product) {
        return;
    }

    const code =
        row.querySelector(
            `input[name="items[${index}][product_code]"]`
        );

    const barcode =
        row.querySelector(
            `input[name="items[${index}][product_barcode]"]`
        );

    const name =
        row.querySelector(
            `input[name="items[${index}][product_name]"]`
        );

    const brand =
        row.querySelector(
            `input[name="items[${index}][product_brand]"]`
        );

    const unit =
        row.querySelector(
            `input[name="items[${index}][product_unit]"]`
        );

    const stockType =
        row.querySelector(
            `select[name="items[${index}][product_stock_type]"]`
        );

    const purchasePrice =
        row.querySelector(
            `input[name="items[${index}][product_purchase_price]"]`
        );

    const sellingPrice =
        row.querySelector(
            `input[name="items[${index}][product_selling_price]"]`
        );

    const minimumStock =
        row.querySelector(
            `input[name="items[${index}][product_minimum_stock]"]`
        );

    if (code) {
        code.value = product.code ?? '';
    }

    if (barcode) {
        barcode.value = product.barcode ?? '';
    }

    if (name) {
        name.value = product.name ?? '';
    }

    if (brand) {
        brand.value = product.brand ?? '';
    }

    if (unit) {
        unit.value = product.unit ?? 'PCS';
    }

    if (stockType) {
        stockType.value = product.stock_type ?? 'STOCK';
    }

    if (purchasePrice) {
        purchasePrice.value =
            product.default_purchase_price ?? 0;
    }

    if (sellingPrice) {
        sellingPrice.value =
            product.default_selling_price ?? 0;
    }

    if (minimumStock) {
        minimumStock.value =
            product.minimum_stock ?? 0;
    }

    calculateWorkOrderTotal();
}
function changeItemType(index, type)
{
    const serviceSelect =
        document.getElementById(`service-select-${index}`);

    const productSelect =
        document.getElementById(`product-select-${index}`);

    if (type === 'SERVICE') {

        serviceSelect.classList.remove('hidden');
        productSelect.classList.add('hidden');

    } else {

        serviceSelect.classList.add('hidden');
        productSelect.classList.remove('hidden');
    }

    changeItemMode(
        index,
        document.querySelector(
            `[data-index="${index}"] select[name="items[${index}][mode]"]`
        ).value
    );
}

function changeItemMode(index, mode)
{
    const row =
        document.querySelector(
            `[data-index="${index}"]`
        );

    const type =
        row.querySelector(
            `select[name="items[${index}][item_type]"]`
        ).value;

    const existing =
        document.getElementById(`existing-${index}`);

    const serviceBox =
        document.getElementById(`new-service-${index}`);

    const productBox =
        document.getElementById(`new-product-${index}`);

    const purchaseBox =
        row.querySelector('.purchase-quantity-box');

    const remainingBox =
        row.querySelector('.remaining-quantity-box');

    if (mode === 'NEW') {

        existing.classList.add('hidden');

        if (purchaseBox) {
            purchaseBox.classList.remove('hidden');
        }

        if (remainingBox) {
            remainingBox.classList.remove('hidden');
        }

        if (type === 'SERVICE') {
            serviceBox.classList.remove('hidden');
            productBox.classList.add('hidden');
        } else {
            serviceBox.classList.add('hidden');
            productBox.classList.remove('hidden');
        }

    } else {

        existing.classList.remove('hidden');
        serviceBox.classList.add('hidden');
        productBox.classList.add('hidden');

        if (purchaseBox) {
            purchaseBox.classList.add('hidden');
        }

        if (remainingBox) {
            remainingBox.classList.add('hidden');
        }
    }
}

setCustomerMode(
    document.getElementById('customer_mode').value
);

addItem();

attachCalculationListeners();
attachRemainingQuantityListeners();
calculateWorkOrderTotal();

</script>

